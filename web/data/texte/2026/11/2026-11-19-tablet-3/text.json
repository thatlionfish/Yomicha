  "grammar": [
    {
      "id": "g1",
      "pattern": "〜一方（で）",
      "j": 3,
      "de": "Kurzform + 一方で: „während …, andererseits …“. Stellt zwei Seiten einer Sache gegenüber: Hier wird manches einfacher, gleichzeitig gibt es Grund zur Sorge. Typisch für Zeitung und Meinungstexte.",
      "ex": "{都会|とかい}は{便利|べんり}な{一方|いっぽう}で、{家賃|やちん}が{高|たか}い。",
      "exDe": "Die Stadt ist praktisch, andererseits ist die Miete hoch."
    },
    {
      "id": "g2",
      "pattern": "〜わけではない",
      "j": 3,
      "de": "Kurzform + わけではない: „es ist nicht so, dass …“. Schwächt eine mögliche Schlussfolgerung ab: Wer Handschrift lobt, sagt damit nicht, dass Tablets schlecht sind.",
      "ex": "{肉|にく}が{嫌|きら}いなわけではないが、{今日|きょう}は{魚|さかな}にする。",
      "exDe": "Es ist nicht so, dass ich Fleisch nicht mag, aber heute nehme ich Fisch."
    },
    {
      "id": "g3",
      "pattern": "〜とは限らない",
      "j": 3,
      "de": "Kurzform + とは限らない: „nicht unbedingt, nicht immer“. Oft mit いつも, 必ず oder 誰でも davor: Ein praktisches Werkzeug hilft nicht automatisch beim Lernen.",
      "ex": "{高|たか}い{店|みせ}がいつもおいしいとは{限|かぎ}らない。",
      "exDe": "Teure Restaurants sind nicht unbedingt immer lecker."
    },
    {
      "id": "g4",
      "pattern": "〜べきだ",
      "j": 3,
      "de": "Wörterbuchform + べきだ: „sollte, müsste“ – eine klare Meinung oder Pflicht. Bei する heißt es するべき oder すべき. In Meinungstexten oft mit と考える: „Ich finde, man sollte …“.",
      "ex": "{約束|やくそく}は{守|まも}るべきだ。",
      "exDe": "Versprechen sollte man halten."
    }
  ],
