  "grammar": [
    {
      "id": "g1",
      "pattern": "〜方",
      "j": 4,
      "de": "Verbstamm (ます-Form ohne ます) + 方（かた）: „die Art, wie man …“. 入れます → 入れ方 = wie man (Tee) zubereitet.",
      "ex": "この{漢字|かんじ}の{読|よ}み{方|かた}を{教|おし}えてください。",
      "exDe": "Bitte sagen Sie mir, wie man dieses Kanji liest."
    },
    {
      "id": "g2",
      "pattern": "〜すぎる",
      "j": 4,
      "de": "Adjektivstamm oder Verbstamm + すぎる: „zu (sehr) …“. 熱い → 熱すぎる = zu heiß sein.",
      "ex": "このかばんは{高|たか}すぎて、{買|か}えません。",
      "exDe": "Diese Tasche ist zu teuer, ich kann sie nicht kaufen."
    },
    {
      "id": "g3",
      "pattern": "〜ことができる",
      "j": 4,
      "de": "Wörterbuchform + ことができます: „… können“ – sagt, dass etwas möglich oder erlaubt ist. In Aushängen häufiger als die kurze Möglichkeitsform.",
      "ex": "この{図書館|としょかん}では、{本|ほん}を{二週間|にしゅうかん}{借|か}りることができます。",
      "exDe": "In dieser Bibliothek kann man Bücher zwei Wochen lang ausleihen."
    },
    {
      "id": "g4",
      "pattern": "〜たら",
      "j": 4,
      "de": "た-Form + ら: „wenn / falls …“. Erst wenn die Bedingung erfüllt ist, gilt der zweite Teil. ある → あったら = falls es … gibt.",
      "ex": "{駅|えき}に{着|つ}いたら、{電話|でんわ}してください。",
      "exDe": "Rufen Sie bitte an, wenn Sie am Bahnhof angekommen sind."
    }
  ],
