  "grammar": [
    {
      "id": "g1",
      "pattern": "〜させる（使役）",
      "j": 4,
      "de": "Kausativ: Verb + させる / せる = „jemanden etwas tun lassen“ oder „jemanden etwas tun heißen“. Die Person, die etwas tun muss, steht mit に. 先生はわたしたちに練習させます = die Lehrerin lässt uns üben.",
      "ex": "{母|はは}は{弟|おとうと}に{部屋|へや}を{掃除|そうじ}させました。",
      "exDe": "Meine Mutter hat meinen kleinen Bruder das Zimmer putzen lassen."
    },
    {
      "id": "g2",
      "pattern": "〜のに",
      "j": 4,
      "de": "Kurzform + のに: „obwohl …“. Drückt aus, dass das Ergebnis anders ist als erwartet, oft mit Enttäuschung. Ich übe jeden Tag viel – und trotzdem kann ich es mir nicht merken.",
      "ex": "{薬|くすり}を{飲|の}んだのに、まだ{頭|あたま}が{痛|いた}いです。",
      "exDe": "Obwohl ich eine Tablette genommen habe, habe ich immer noch Kopfschmerzen."
    },
    {
      "id": "g3",
      "pattern": "〜たほうがいい",
      "j": 4,
      "de": "た-Form + ほうがいい: „es wäre besser, …“ – ein Rat oder eine Meinung. Mit と思います klingt es vorsichtiger: „Ich finde, man sollte besser …“.",
      "ex": "{寒|さむ}いので、コートを{着|き}たほうがいいですよ。",
      "exDe": "Es ist kalt, du solltest besser einen Mantel anziehen."
    }
  ],
